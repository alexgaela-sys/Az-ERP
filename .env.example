VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="public anon / publishable key (never the service_role key)"
# Required to switch the app into cloud mode at all (see src/main.tsx) — without
# this set to exactly "supabase", the build runs in local-browser-only mode and
# silently ignores the two keys above.
VITE_ERP_STORAGE="supabase"
